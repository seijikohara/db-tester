{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Shared policy: https://github.com/seijikohara/renovate-config
  extends: ["github>seijikohara/renovate-config:default.json5"],
  packageRules: [
    {
      description: "Group the Spring ecosystem",
      groupName: "spring",
      matchPackageNames: ["/^org\\.springframework/"],
    },
    {
      description: "Group the test frameworks to reduce PR churn",
      groupName: "test frameworks",
      matchPackageNames: ["/^org\\.junit/", "/^org\\.spockframework/", "/^io\\.kotest/"],
    },
    {
      // Spock encodes the Groovy line in its version (2.5-groovy-6.0 requires
      // Groovy 6.0.0), so a "minor" Spock bump could switch to another Groovy line
      // without the dashboard approval that a groovy-bom major needs. Change the
      // suffix only together with an approved groovy-bom major update.
      description: "Keep Spock on the variant for the project's Groovy line (Groovy 6)",
      matchPackageNames: ["/^org\\.spockframework/"],
      allowedVersions: "/-groovy-6\\.0$/",
    },
  ],
}
